00012   0000             
00013   0000             
00014   0000             VERSION2	equ	1	; Segunda version de la ROM con correccion de fallos
00015   0000             
00016   0000             ;-------------------------------------------------------------------------------
00017   0000             ; Modificando la constante VERSION2 se pueden generar las dos versiones del juego que existen
00018   0000             ; La version 2 [A1] corrige algunos fallos de la version previa como:
00019   0000             ;
00020   0000             ; - Impide que se pueda lanzar un cuchillo cuando la puerta se esta abriendo.
00021   0000             ;   De esta forma se evita que se corrompa el grafico de la puerta al pasar el cuchillo sobre ella
00022   0000             ;
00023   0000             ; - Impide que se pueda lanzar un cuchillo cuando se esta pegado a un objeto (gema, pico, etc...)
00024   0000             ;   En la version original atravesaba el objeto al lanzar el cuchillo
00025   0000             ;
00026   0000             ; - Se puede picar sobre un muro trampa
00027   0000             ;
00028   0000             ; - Corregida la posicion del muro trampa de la piramide 10 de la pantalla de la izquierda, abajo a la izquierda (aparece al coger el cuchillo)
00029   0000             ;   La version original lo tenía en la pantalla de la derecha bajo las escaleras. Pero hacia falta cabar un par de ladrillos del suelo para que apareciese.
00030   0000             ;
00031   0000             ; - Modificación de la posicion del muro trampa de la pirámide 12, en la pantalla de la derecha, abajo a la derecha (aparece al coger el pico) Se ha movido un tile a la derecha (?)
00032   0000             ;
00033   0000             ; - Los muros trampa se detienen al chocar contra un objeto. En la version anterior lo borraba (erroneamente decrementaba los decimales X en vez de la coordenada Y)
00034   0000             ;-------------------------------------------------------------------------------
00035   0000             
00036   0000             ; En la piramide 10-2 hay una momia que parece por encima del suelo (!?)
00037   0000             
00038   0000             ;-------------------------------------------------------------------------------
00039   0000             ; Estructuras
00040   0000             ;-------------------------------------------------------------------------------
00041   0000             
00042   0000             ;--------------------------------------
00043   0000             ; ACTOR
00044   0000             ;--------------------------------------
00045   0000             ACTOR_STATUS:	 equ	0
00046   0000             ACTOR_CONTROL:	 equ	1			; 1 = Arriba, 2	= Abajo, 4 = Izquierda,	8 = Derecha
00047   0000             ACTOR_SENTIDO:	 equ	2			; 1 = Izquierda, 2 = Derecha
00048   0000             ACTOR_Y:	 equ	3
00049   0000             ACTOR_X_DECIMAL: equ	4
00050   0000             ACTOR_X:	 equ	5
00051   0000             ACTOR_ROOM:	 equ	6
00052   0000             ACTOR_SPEEDXDEC: equ	7
00053   0000             ACTOR_SPEED_X:	 equ	8
00054   0000             ACTOR_SPEEDROOM: equ	9
00055   0000             ACTOR_MOV_CNT:	 equ	0Ah
00056   0000             ACTOR_FRAME:	 equ	0Bh
00057   0000             ACTOR_JMP_P:	 equ	0Ch		; Puntero a tabla con los valores del salto
00058   0000             ACTOR_JMP_P_H:	 equ	0Dh
00059   0000             ACTOR_JUMPSENT:	 equ	0Eh		; 0 = Subiendo,	1 = Cayendo
00060   0000             ACTOR_SENT_ESC:	 equ	0Fh		; Sentido en el	que van	las escaleras. 0 = \  1	= /
00061   0000             ACTOR_POS_RELAT: equ	10h		; 0 = A	la misma altura	(o casi), 1 = Momia por	encima,	2 = Por	debajo
00062   0000             ACTOR_TIMER:	 equ	11h
00063   0000             ACTOR_TIPO:	 equ	14h
00064   0000             ACTOR_STRESS:	 equ	15h		; Contador de stress de	la momia (para saber si	choca muy a menudo)
00065   0000             
00066   0000             ;--------------------------------------
00067   0000             ; Puerta giratoria
00068   0000             ;--------------------------------------
00069   0000             SPINDOOR_STATUS: equ	0
00070   0000             SPINDOOR_Y:	 equ	1
00071   0000             SPINDOOR_X_DEC:	 equ	2
00072   0000             SPINDOOR_X:	 equ	3
00073   0000             SPINDOOR_ROOM:	 equ	4
00074   0000             SPINDOOR_SENT:	 equ	5
00075   0000             SPINDOOR_TIMER:	 equ	6
00076   0000             
00077   0000             ;--------------------------------------
00078   0000             ; MUSIC
00079   0000             ;--------------------------------------
00080   0000             MUSIC_CNT_NOTA:	 equ	0
00081   0000             MUSIC_DURAC_NOTA: equ	1
00082   0000             MUSIC_ID:	 equ	2
00083   0000             MUSIC_ADD_LOW:	 equ	3
00084   0000             MUSIC_ADD_HIGH:	 equ	4
00085   0000             MUSIC_OCTAVA:	 equ	5			; Octava?
00086   0000             MUSIC_VOLUME_CH: equ	6			; Volumen canal
00087   0000             MUSIC_VOLUME:	 equ	7
00088   0000             MUSIC_CNT_LOOP:	 equ	9			; Veces	que se ha reproducido un pattern
00089   0000             MUSIC_TEMPO:	 equ	0Ah
00090   0000             
00091   0000             ;-------------------------------------------------------------------------------
00092   0000             ; BIOS
00093   0000             ;-------------------------------------------------------------------------------
00094   0000             
00095   0000             byte_6:		equ	6
00096   0000             byte_7:		equ	7
00097   0000             WRTVDP:		equ	#47
00098   0000             RDVRM:		equ	#4a
00099   0000             WRTVRM:		equ	#4d
00100   0000             SETRD:		equ	#50
00101   0000             SETWR:		equ	#53
00102   0000             WRTPSG:		equ	#93
00103   0000             RDPSG:		equ	#96
00104   0000             RDVDP:		equ	#13e
00105   0000             SNSMAT:		equ	#141	;  Read	keyboard row
00106   0000             
00107   0000             H_TIMI:		equ	#fd9a
00108   0000             
00109   0000             
