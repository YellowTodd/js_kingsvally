06345   6839 E1          		pop	hl
06346   683A 7E          		ld	a, (hl)		; Y del	muro
06347   683B E6 07       		and	7		; Ha bajado un tile completo o medio?
06348   683D 20 04       		jr	nz, murosTrampa3 ; Medio
06349   683F             
06350   683F 1A          		ld	a, (de)		; Tile del mapa
