00445   4141             ;----------------------------------------------------------------------------
00446   4141             ;
00447   4141             ; Start	game (4)
00448   4141             ;
00449   4141             ;
00450   4141             ;----------------------------------------------------------------------------
00451   4141             
00452   4141             StartGame:
00453   4141 3A 51 E0    		ld	a, (flagPiramideMap) ; 0 = Mostrando mapa, 1 = Dentro de la piramide
00454   4144 1F          		rra			; Se esta mostrando el mapa de piramides?
00455   4145 D2 B9 41    		jp	nc, showMap
00456   4148             
00457   4148 78          		ld	a, b		; Substatus
00458   4149 B7          		or	a		; Si es	igual a	cero esta haciendo la cortinilla desde el menu
00459   414A 28 05       		jr	z, waitEntrada	; No dibuja el brillo de las gemas
