00112   0000             
00113   0000             ;-------------------------------------------------------------------------------
00114   0000             ;
00115   0000             ; ROM header
00116   0000             ;
00117   0000             ;-------------------------------------------------------------------------------
00118   0000             		SIZE    16 * 1024       ; ROM de 16K
00119   0000             
00120   0000             		org	#4000
00121   4000             
00122   4000 41 42       		dw	4241h
00123   4002 6C 40       		dw	startCode
00124   4004 00 00       		dw	0
00125   4006 00 00       		dw	0
00126   4008 00 00       		dw	0
00127   400A 00 00       		dw	0
00128   400C 00 00       		dw	0
00129   400E 00 00       		dw	0
00130   4010             
00131   4010             ;----------------------------------------------------
00132   4010             ; Suma HL + A
00133   4010             ;----------------------------------------------------
00134   4010             
00135   4010             ADD_A_HL:
00136   4010 85          		add	a, l
00137   4011 6F          		ld	l, a
00138   4012 D0          		ret	nc
00139   4013 24          		inc	h
00140   4014 C9          		ret
00141   4015             
00142   4015             ;----------------------------------------------------
00143   4015             ; Suma DE + A
00144   4015             ;----------------------------------------------------
00145   4015             
00146   4015             ADD_A_DE:
00147   4015 83          		add	a, e
00148   4016 5F          		ld	e, a
00149   4017 D0          		ret	nc
00150   4018 14          		inc	d
00151   4019 C9          		ret
00152   401A             
00153   401A             
00154   401A             ;-------------------------------------------------------------------------------
00155   401A             ;
00156   401A             ; MAIN
00157   401A             ;
00158   401A             ; Funcion principal llamada desde el gancho de interrupcion (50	o 60 Hz)
00159   401A             ; Actualiza el reproductor de sonido
00160   401A             ; Evita	que se ejecute la logica al producirse una interrupcion	si no ha
00161   401A             ; terminado la iteracion anterior
00162   401A             ;-------------------------------------------------------------------------------
00163   401A             
00164   401A             tickMain:
00165   401A CD 3E 01    		call	RDVDP		; Borra	el flag	de interrupcion
00166   401D F3          		di
00167   401E CD 36 7B    		call	updateSound	; Actualiza el driver de sonido
00168   4021             
00169   4021 21 05 E0    		ld	hl, tickInProgress ; Si	el bit0	esta a 1 no se ejecuta la logica del juego
00170   4024 CB 46       		bit	0, (hl)
00171   4026 20 0C       		jr	nz, tickMain2	; No se	ha terminado la	iteracion anterior
00172   4028             
00173   4028 34          		inc	(hl)		; Indica que se	va a realizar una iteracion
00174   4029 FB          		ei
00175   402A CD C8 45    		call	chkControls	; Actualiza el estado de los controles
00176   402D CD A3 40    		call	runGame		; Ejecuta la logica del	juego
00177   4030             
00178   4030 AF          		xor	a
00179   4031 32 05 E0    		ld	(tickInProgress), a ; Indica que ha terminado la iteracion actual
00180   4034             
00181   4034             tickMain2:
00182   4034 CD 3E 01    		call	RDVDP		; Lee y	borra el flag de interrupcion
00183   4037 B7          		or	a		; Se ha	producido una interrupcion mientras se ejecutaba logica	del juego?
00184   4038 F3          		di
00185   4039 FC 36 7B    		call	m, updateSound	; Si, actualiza	el sonido
00186   403C FB          		ei
00187   403D C9          		ret
00188   403E             
00189   403E             
00190   403E             ;----------------------------------------------------
00191   403E             ; Lee el estado	de las teclas
00192   403E             ; Proteccion anticopia (!?)
00193   403E             ; Si se	ejecuta	en RAM machaca el programa
00194   403E             ;----------------------------------------------------
00195   403E             
00196   403E             ReadKeys_AC:
00197   403E 21 E4 40    		ld	hl, KonamiLogo2
00198   4041 3A 4C 40    		ld	a, (JumpIndex2)
00199   4044 77          		ld	(hl), a
00200   4045 23          		inc	hl
00201   4046 36 C9       		ld	(hl), 0C9h	; RET opcode
00202   4048 C3 E8 45    		jp	ReadKeys
00203   404B             
00204   404B             ;----------------------------------------------------
00205   404B             ; Jump index
00206   404B             ; (SP) = Puntero a funciones
00207   404B             ;  A = Indice de la funcion
00208   404B             ;----------------------------------------------------
00209   404B             
00210   404B             jumpIndex:
00211   404B 87          		add	a, a
00212   404C             
00213   404C             JumpIndex2:
00214   404C E1          		pop	hl
00215   404D CD 49 6D    		call	getIndexHL_A
00216   4050 E9          		jp	(hl)
00217   4051             
00218   4051             
00219   4051             ;----------------------------------------------------
00220   4051             ; Igual	que WriteDataVRAM pero escribiendo siempre 0
00221   4051             ;----------------------------------------------------
00222   4051             
00223   4051             ClearDataVRAM:
00224   4051 0E 00       		ld	c, 0		; Mascara a aplicar con	AND al byte a escribir
00225   4053 18 02       		jr	writeDataVRAM2
00226   4055             
00227   4055             
00228   4055             ;----------------------------------------------------
00229   4055             ; Escribe en la	VRAM datos con formato
00230   4055             ; In:
00231   4055             ;   C =	Mascara	AND aplicada al	dato a escribir
00232   4055             ;  DE =	direccion datos
00233   4055             ;  0-1:	VRAM address
00234   4055             ;  2...: Datos
00235   4055             ; Datos:
00236   4055             ;  FE: next block (nueva direccion + datos)
00237   4055             ;  FF: end datos
00238   4055             ;----------------------------------------------------
00239   4055             
00240   4055             WriteDataVRAM:
00241   4055 0E FF       		ld	c, 0FFh		; Mascara a aplicar con	AND al byte a escribir
00242   4057             
00243   4057             writeDataVRAM2:
00244   4057 EB          		ex	de, hl
00245   4058 5E          		ld	e, (hl)
00246   4059 23          		inc	hl
00247   405A 56          		ld	d, (hl)
00248   405B EB          		ex	de, hl
00249   405C 13          		inc	de
00250   405D             
00251   405D             writeDataVRAM3:
00252   405D 1A          		ld	a, (de)
00253   405E 13          		inc	de
00254   405F 47          		ld	b, a
00255   4060 04          		inc	b		; Es #FF?
00256   4061 C8          		ret	z		; Fin de los datos
00257   4062             
00258   4062 04          		inc	b		; Es #FE?
00259   4063 28 F2       		jr	z, writeDataVRAM2 ; Cambia puntero a VRAM
00260   4065             
00261   4065 A1          		and	c		; Aplica mascara AND al	dato a escribir	en la VRAM
00262   4066 CD 4D 00    		call	WRTVRM
00263   4069 23          		inc	hl
00264   406A 18 F1       		jr	writeDataVRAM3
00265   406C             
00266   406C             ;-------------------------------------------------------------------------------
00267   406C             ;
00268   406C             ; Boot code
00269   406C             ;
00270   406C             ; Fija la rutina de interrupcion que llamara a la logica del juego cada	frame
00271   406C             ; Borra	el area	de variables
00272   406C             ; Inicializa el	hardware (modo de video, PSG)
00273   406C             ; Ejecuta un loop infinito, tipico de Konami.
00274   406C             ;-------------------------------------------------------------------------------
00275   406C             
00276   406C             startCode:
00277   406C F3          		di
00278   406D ED 56       		im	1
00279   406F 3E C3       		ld	a, 0C3h
00280   4071 32 9A FD    		ld	(H_TIMI), a
00281   4074 21 1A 40    		ld	hl, tickMain
00282   4077 22 9B FD    		ld	(H_TIMI+1), hl	; Pone la rutina de interrupcion que lleva la logica del juego
00283   407A             
00284   407A 31 00 E7    		ld	sp, stackTop	; Fija el lugar de la pila
00285   407D 21 00 E0    		ld	hl, GameStatus
00286   4080 11 01 E0    		ld	de, subStatus
00287   4083 01 FF 06    		ld	bc, 6FFh
00288   4086 36 00       		ld	(hl), 0
00289   4088 ED B0       		ldir			; Inicializa el	area de	variables del juego
00290   408A             
00291   408A 3E 01       		ld	a, 1
00292   408C 32 05 E0    		ld	(tickInProgress), a ; Evita que	se ejecute la logica del juego mientras	se inicializa el hardware
00293   408F CD 9B 45    		call	initHardware	; Inicializa el	modo de	video y	el PSG
00294   4092             
00295   4092 AF          		xor	a
00296   4093 32 05 E0    		ld	(tickInProgress), a ; Permite que se ejecute la	logica del juego en la proxima interrupcion
00297   4096 CD 3E 01    		call	RDVDP		; Borra	el flag	de interrupcion
00298   4099 FB          		ei
00299   409A             
00300   409A             dummyLoop:
00301   409A 18 FE       		jr	$
00302   409C             
00303   409C             ;----------------------------------------------------
00304   409C             ; VRAM write con proteccion anticopia
00305   409C             ; Antes	de escribir en la VRAM machaca el codigo si se ejecuta en RAM
00306   409C             ;----------------------------------------------------
00307   409C             
00308   409C             VRAM_writeAC:
00309   409C ED 53 C0 43 		ld	(copyProtect_+1), de ; Proteccion anticopia (!?)
00310   40A0 C3 AB 44    		jp	setFillVRAM
00311   40A3             
00312   40A3             ;-------------------------------------------------------------------------------
00313   40A3             ;
00314   40A3             ; Tick game
00315   40A3             ;
00316   40A3             ;-------------------------------------------------------------------------------
00317   40A3             
00318   40A3             runGame:
00319   40A3 21 03 E0    		ld	hl, timer
00320   40A6 34          		inc	(hl)		; Incrementa timer global del juego
00321   40A7             
00322   40A7 ED 4B 00 E0 		ld	bc, (GameStatus) ;  C =	Game status, B = Substatus
00323   40AB 3A 02 E0    		ld	a, (controlPlayer) ; bit 6 = Prota controlado por el jugador
00324   40AE CB 77       		bit	6, a		; Se esta jugando?
00325   40B0 20 04       		jr	nz, runGame2	; Si, no esta en modo demo o en	el menu
00326   40B2             
00327   40B2 21 44 46    		ld	hl, chkPushAnyKey ; Se añade esta funcion para comprobar si se pulsa una tecla y hay que empezar una partida
00328   40B5 E5          		push	hl
00329   40B6             
00330   40B6             runGame2:
00331   40B6 79          		ld	a, c
00332   40B7 CD 4B 40    		call	jumpIndex
00333   40BA             
00334   40BA D0 40       		dw KonamiLogo		; 0 = Muestra el logo de Konami
00335   40BC 0D 41       		dw WaitMainMenu		; 1 = Espera en	el menu. Si   no se pulsa una tecla salta a la demo
00336   40BE 15 41       		dw SetDemo		; 2 = Prepara el modo demo
00337   40C0 9F 42       		dw iniciaPartida	; 3 = Reproduce	musica inicio, parpadea	PLAY START y pasa al modo de juego
00338   40C2 41 41       		dw StartGame		; 4 = Borra menu, dibuja piramide, puerta y como entra el prota
00339   40C4 D5 41       		dw gameLogic		; 5 = Logica del pergamino o del juego
00340   40C6 F5 41       		dw tickMuerto		; 6 = Pierde una vida /	Muestra	mensaje	de Game	Over
00341   40C8 43 42       		dw tickGameOver		; 7 = Game Over
00342   40CA 66 42       		dw stageClear		; 8 = Stage clear (suma	una vida y activa el pergamino)
00343   40CC 7B 42       		dw ScrollPantalla	; 9 = Scroll pantalla
00344   40CE 9C 42       		dw FinalJuego		; 10 = Muestra el final	del juego
00345   40D0             
00346   40D0             
00347   40D0             ;----------------------------------------------------------------------------
00348   40D0             ; Konami logo (0)
00349   40D0             ; 0 = Inicializa logo: borra pantalla, carga graficos y	pone modo grafico
00350   40D0             ; 1 = Sube el logo cada	2 frames. Subraya Konami y pone	el texto "SOFTWARE"
00351   40D0             ; 2 = Espera un	rato y borra la	pantalla.
00352   40D0             ; 3 = Dibuja el	menu.
00353   40D0             ;----------------------------------------------------------------------------
00354   40D0             
00355   40D0             KonamiLogo:
00356   40D0 10 12       		djnz	KonamiLogo2
00357   40D2 3A 03 E0    		ld	a, (timer)
00358   40D5 1F          		rra
00359   40D6 D0          		ret	nc		; Sube el logo cada dos	frames
00360   40D7             
00361   40D7 CD 42 48    		call	dibujaLogo
00362   40DA C0          		ret	nz		; Aun esta subiendo el logo
00363   40DB             
00364   40DB 11 FE 47    		ld	de, TXT_Sofware
00365   40DE CD 14 45    		call	unpackGFXset	; Subraya Konami y pone	texto "Software"
00366   40E1 AF          		xor	a
00367   40E2 18 55       		jr	UpdateSubstatus
00368   40E4             
00369   40E4             KonamiLogo2:
00370   40E4 10 11       		djnz	KingsValleyLogo
00371   40E6 21 04 E0    		ld	hl, waitCounter
00372   40E9 35          		dec	(hl)
00373   40EA C0          		ret	nz		; Espera un rato mostrando el logo
00374   40EB             
00375   40EB CD A1 44    		call	clearScreen
00376   40EE CD C5 42    		call	setColor
00377   40F1 AF          		xor	a
00378   40F2 32 0A E0    		ld	(gameLogoCnt), a ; Contador que	indica que parte del logo del menu se esta pintando
00379   40F5 18 13       		jr	doNextSubStatus
00380   40F7             
00381   40F7             KingsValleyLogo:
00382   40F7 10 08       		djnz	InitLogo
00383   40F9 CD B8 43    		call	drawGameLogo	; Dibuja el menu
00384   40FC D8          		ret	c
00385   40FD AF          		xor	a
00386   40FE C3 AD 41    		jp	NextGameStatus_
00387   4101             
00388   4101             InitLogo:
00389   4101 CD A1 44    		call	clearScreen
00390   4104 CD CC 42    		call	LoadIntroGfx
00391   4107 CD AF 45    		call	SetVideoMode
00392   410A             
00393   410A             doNextSubStatus:
00394   410A C3 3C 41    		jp	NextSubStatus
00395   410D             
00396   410D             ;----------------------------------------------------------------------------
00397   410D             ; Menu (1)
00398   410D             ; Espera un rato y salta a la demo
00399   410D             ;----------------------------------------------------------------------------
00400   410D             
00401   410D             WaitMainMenu:
00402   410D 21 04 E0    		ld	hl, waitCounter
00403   4110 35          		dec	(hl)
00404   4111 C0          		ret	nz		; Hay que seguir esperando
00405   4112             
00406   4112 C3 AB 41    		jp	NextGameStatusT	; Pasa al modo demo
00407   4115             
00408   4115             ;----------------------------------------------------------------------------
00409   4115             ;
00410   4115             ; Game demo (2)
00411   4115             ; Pone el status de juego e inicializa las variables de	la demo
00412   4115             ;
00413   4115             ;----------------------------------------------------------------------------
00414   4115             
00415   4115             SetDemo:
00416   4115 21 04 00    		ld	hl, 4		; Start	game status, substatus = 0
00417   4118 22 00 E0    		ld	(GameStatus), hl
00418   411B 2E 00       		ld	l, 0
00419   411D 22 62 E0    		ld	(PiramidesPasadas), hl ; Cada bit indica si la piramide	correspondiente	ya esta	pasada/terminada
00420   4120 7D          		ld	a, l
00421   4121 32 58 E0    		ld	(numFinishGame), a ; Numero de veces que se ha terminado el juego
00422   4124             
00423   4124 CD 17 43    		call	setDatosPartida
00424   4127             
00425   4127 21 05 08    		ld	hl, 805h	; Piramide 5, puerta de	la derecha
00426   412A 22 55 E0    		ld	(piramideDest),	hl
00427   412D             
00428   412D 21 CE 4A    		ld	hl, DemoKeyData	; Controles grabados de	la demo
00429   4130 22 80 E0    		ld	(keyPressDemo),	hl ; Puntero a los controles grabados
00430   4133             
00431   4133 3E 08       		ld	a, 8
00432   4135 32 82 E0    		ld	(KeyHoldCntDemo), a
00433   4138 C9          		ret
00434   4139             
00435   4139             UpdateSubstatus:
00436   4139 32 04 E0    		ld	(waitCounter), a
00437   413C             
00438   413C             NextSubStatus:
00439   413C 21 01 E0    		ld	hl, subStatus
00440   413F 34          		inc	(hl)
00441   4140             
00442   4140             doNothing:
00443   4140 C9          		ret
