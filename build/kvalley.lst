01898   4823             ;----------------------------------------------------
01899   4823             
01900   4823             loadKonamiLogo:
01901   4823 3E 0E       		ld	a, 0Eh
01902   4825 32 0A E0    		ld	(gameLogoCnt), a ; Filas que sube el logo
01903   4828             
01904   4828 21 AA 3A    		ld	hl, 3AAAh	; Coordenadas iniciales	del logo
01905   482B 22 0E E0    		ld	(CoordKonamiLogo), hl
01906   482E             
01907   482E 11 74 48    		ld	de, GFX_KonamiLogo
01908   4831 21 00 63    		ld	hl, 6300h	; #2300	Pattern	generator table	= Patter #60
01909   4834 CD F1 44    		call	UnpackPatterns
01910   4837             
01911   4837 21 00 03    		ld	hl, 300h	; Direccion de los atributos de	color del logo
01912   483A 01 D8 00    		ld	bc, 0D8h	; Tamaño
01913   483D 3E F0       		ld	a, 0F0h		; Blanco
01914   483F C3 E0 44    		jp	fillVRAM3Bank	; Colorea el logo
