05086   5D0B             ;----------------------------------------------------
05087   5D0B             ; Comprueba si las coordendas DE estan dentro de una
05088   5D0B             ; determinada area
05089   5D0B             ;
05090   5D0B             ; DE indica las	coordenadas del	punto a	comprobar
05091   5D0B             ; E = X	punto
05092   5D0B             ; D = Y	punto
05093   5D0B             ; A DE se le aplica un desplazamiento para indicar que
05094   5D0B             ; punto	exacto del elemento se quiere comprobar	(por ejemplo el	centro de una momia)
05095   5D0B             ;
05096   5D0B             ; BC incia las coordenadas del area a comprobar
05097   5D0B             ; B = X	area
05098   5D0B             ; C = Y	area
05099   5D0B             ; El Tamaño del	area viene indicado por	HL+1 y HL+3
05100   5D0B             
05101   5D0B             ; HL:
05102   5D0B             ; +0 = Offset X1
05103   5D0B             ; +1 = Ancho area
05104   5D0B             ; +2 = Offset Y1
05105   5D0B             ; +3 = Alto area
05106   5D0B             ;
05107   5D0B             ;----------------------------------------------------
05108   5D0B             
05109   5D0B             chkArea:
05110   5D0B 78          		ld	a, b		; X area
05111   5D0C 93          		sub	e		; X punto
05112   5D0D 96          		sub	(hl)		; Offset X del punto
05113   5D0E 23          		inc	hl
05114   5D0F 86          		add	a, (hl)		; Ancho	del area
05115   5D10 30 06       		jr	nc, chkArea2	; No esta dentro
05116   5D12             
05117   5D12 79          		ld	a, c		; Y area
05118   5D13 92          		sub	d		; Y punto
05119   5D14 23          		inc	hl
05120   5D15 96          		sub	(hl)		; Offset Y del punto
05121   5D16 23          		inc	hl
05122   5D17 86          		add	a, (hl)		; Alto del area
05123   5D18             
05124   5D18             chkArea2:
05125   5D18 C9          		ret
