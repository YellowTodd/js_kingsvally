05673   6593             ;----------------------------------------------------
05674   6593             ; Patrones usados para dibujar como se hace un agujero con el pico
05675   6593             ; Para calcular	el indice se suma a esta lista el valor	del contador de	animacion
05676   6593             ; Este contador	se decrementa de 3 en 3	y empieza en #15
05677   6593             ; El primer valor que se usa es	#12 (tile = #43)
05678   6593             ; La animacion es #43, #44, 0, #43, #44, 0, 0
05679   6593             ;----------------------------------------------------
05680   6593 00          tilesAnimCavar:	db 0
05681   6594 00 00 00    		db 0, 0, 0
05682   6597 00 00 44    		db 0, 0, 44h
05683   659A 00 00 43    		db 0, 0, 43h
05684   659D 00 00 00    		db 0, 0, 0
05685   65A0 00 00 44    		db 0, 0, 44h
05686   65A3 00 00 43    		db 0, 0, 43h
