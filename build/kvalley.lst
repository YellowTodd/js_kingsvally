05770   65D7             ; Pone en el mapa los destellos	de una gema
05771   65D7             ; HL = Puntero a la posicion de	la gema	en el mapa
05772   65D7             ; DE = Puntero a patrones para brillos
05773   65D7             ;----------------------------------------------------
05774   65D7             
05775   65D7             
05776   65D7             putBrillosMap:
05777   65D7 01 A0 FF    		ld	bc, -60h	; Tamaño de una	fila del mapa (3 pantallas de 32 tiles)
05778   65DA 09          		add	hl, bc		; Fila superior
05779   65DB EB          		ex	de, hl
05780   65DC ED A0       		ldi			; Pone brillo superior de la gema
05781   65DE 01 5E 00    		ld	bc, 5Eh		; Distancia al brillo de la izquierda
05782   65E1 EB          		ex	de, hl
05783   65E2 09          		add	hl, bc
05784   65E3 EB          		ex	de, hl
05785   65E4 0E 03       		ld	c, 3
05786   65E6 ED B0       		ldir			; Copia	brillo de la izquierda,	espacio, brillo	de la derecha
05787   65E8 EB          		ex	de, hl
05788   65E9 C9          		ret
