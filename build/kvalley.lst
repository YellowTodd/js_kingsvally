05601   6536 AF          		xor	a
05602   6537 CD B5 65    		call	getGemaDat	; Obtiene puntero a los	datos de la gema en proceso
05603   653A 23          		inc	hl
05604   653B 7E          		ld	a, (hl)		; Status
05605   653C CD 4B 40    		call	jumpIndex
05606   653F 47 65       		dw gemaDoNothing
05607   6541 47 65       		dw gemaDoNothing
