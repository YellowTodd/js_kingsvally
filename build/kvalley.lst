05716   65B5             ;----------------------------------------------------
05717   65B5             ; Devuelve en HL el puntero a los datos	de la gema y en	A la variable indicada
05718   65B5             ; In:
05719   65B5             ;   A =	Offset a la variable de	la estructura
05720   65B5             ; Out:
05721   65B5             ;  HL =	Puntero	a la variable indicada de la gema en proceso
05722   65B5             ;   A =	Valor de la variable
05723   65B5             ;----------------------------------------------------
05724   65B5             
05725   65B5             
05726   65B5             getGemaDat:
05727   65B5 21 F5 E1    		ld	hl, datosGemas	; 0 = Color/activa. Nibble alto	indica el color. El bajo si esta activa	(1) o no (0)
05728   65B8             					; 1 = Status
05729   65B8             					; 2 = Y
05730   65B8             					; 3 = decimales	X
05731   65B8             					; 4 = X
05732   65B8             					; 5 = habitacion
05733   65B8             					; 6-8 =	0, 0, 0
05734   65B8 CD 10 40    		call	ADD_A_HL
05735   65BB 3A F4 E1    		ld	a, (ElemEnProceso) ; Usado para	saber la gema o	puerta que se esta procesando
05736   65BE             
05737   65BE             getIndexX9:
05738   65BE 47          		ld	b, a
05739   65BF             
05740   65BF             getIndexX8_masB:
05741   65BF 87          		add	a, a
05742   65C0             
05743   65C0             getIndexX4_masB:
05744   65C0 87          		add	a, a
05745   65C1 87          		add	a, a
05746   65C2 80          		add	a, b
05747   65C3 CD 10 40    		call	ADD_A_HL
05748   65C6 7E          		ld	a, (hl)
05749   65C7 C9          		ret
05750   65C8             ;----------------------------------------------------
05751   65C8             ;
05752   65C8             ; Envia	a la VRAM los datos apuntados por DE.
05753   65C8             ; B = Alto
05754   65C8             ; C = Ancho
05755   65C8             ;
05756   65C8             ;----------------------------------------------------
05757   65C8             
05758   65C8             DEtoVRAM_NXNY:
05759   65C8 C5          		push	bc
05760   65C9 06 00       		ld	b, 0
05761   65CB CD C0 44    		call	DEtoVRAMset
05762   65CE 3E 20       		ld	a, 20h		; Siguiente fila (incrementa coordenada	Y)
05763   65D0 CD 10 40    		call	ADD_A_HL
05764   65D3 C1          		pop	bc
05765   65D4 10 F2       		djnz	DEtoVRAM_NXNY
05766   65D6 C9          		ret
