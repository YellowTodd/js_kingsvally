07518   6D13             	ELSE
07519   6D13~            		ldi			; Copia	la Y
07520   6D13~            
07521   6D13~            		inc	de		; Pasa decimales X
07522   6D13~            
07523   6D13~            		ld	a, (hl)
07524   6D13~            		and	0F8h		; Ajusta la coordenada X a multiplo de 8
07525   6D13~            		ld	(de), a		; X
07526   6D13~            
07527   6D13~            		inc	de
07528   6D13~            		ld	a, (hl)
07529   6D13~            		and	1
07530   6D13~            		ld	(de), a		; Habitacion de	inicio (xHigh)
07531   6D13~            
07532   6D13~            		inc	de
07533   6D13~            		inc	hl
07534   6D13             	ENDIF
