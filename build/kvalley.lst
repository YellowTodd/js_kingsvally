01916   4842             
01917   4842             
01918   4842             ;----------------------------------------------------
01919   4842             ;
01920   4842             ; Dibuja el logo de Konami y lo	desplaza hacia arriba
01921   4842             ;
01922   4842             ; El logo esta formado por tres	filas:
01923   4842             ; - Parte superior de la "K"
01924   4842             ; - Parte central del logo
01925   4842             ; - Parte inferior
01926   4842             ;----------------------------------------------------
01927   4842             
01928   4842             dibujaLogo:
01929   4842 2A 0E E0    		ld	hl, (CoordKonamiLogo)
01930   4845 11 E0 FF    		ld	de, -20h
01931   4848 19          		add	hl, de
01932   4849 22 0E E0    		ld	(CoordKonamiLogo), hl ;	Lo desplaza hacia arriba una fila
01933   484C             
01934   484C 3E 60       		ld	a, 60h		; Primer patron	del logo de Konami
01935   484E 06 03       		ld	b, 3		; Tres patrones	de la parte alta de la "K"
01936   4850 CD 66 48    		call	drawLogoRow	; Dibuja fila superior
01937   4853             
01938   4853 01 0C 0B    		ld	bc, 0B0Ch
01939   4856 CD 66 48    		call	drawLogoRow	; Dibuja fila central
01940   4859             
01941   4859 41          		ld	b, c
01942   485A CD 66 48    		call	drawLogoRow	; Dibuja fila inferior
01943   485D             
01944   485D AF          		xor	a
01945   485E CD AB 44    		call	setFillVRAM	; Borra	rasto inferior
01946   4861 21 0A E0    		ld	hl, gameLogoCnt
01947   4864 35          		dec	(hl)		; Decrementa el	numero de iteraciones restantes
01948   4865 C9          		ret
01949   4866             
01950   4866             ;----------------------------------------------------
01951   4866             ; Dibuja una fila del logo y desplaza el puntero a la siguiente	fila
01952   4866             ;
01953   4866             ; A = Patron inicial de	la fila
01954   4866             ; B = Numero de	patrones a dibujar
01955   4866             ;----------------------------------------------------
01956   4866             
01957   4866             drawLogoRow:
01958   4866 E5          		push	hl
01959   4867             
01960   4867             drawLogoRow2:
01961   4867 CD 4D 00    		call	WRTVRM
01962   486A 23          		inc	hl
01963   486B 3C          		inc	a
01964   486C 10 F9       		djnz	drawLogoRow2
01965   486E D1          		pop	de
01966   486F 21 20 00    		ld	hl, 20h
01967   4872 19          		add	hl, de		; Siguiente fila del logo
01968   4873 C9          		ret
