07505   6D00 23          		inc	hl
07506   6D01 23          		inc	hl
07507   6D02 23          		inc	hl
07508   6D03 11 4E E1    		ld	de, momiasPiramid ; Datos de las momias	que hay	en la piramide actual: y, x (%xxxxx--p), tipo
07509   6D06 3A 65 E1    		ld	a, (momiaEnProceso)
07510   6D09 4F          		ld	c, a
