04996   5CA8             ; La momia tiene que estar viva	y en un	estado activo
04997   5CA8             ; Si el	prota o	la momia esta en una escalera, ambos tendran que estar en escaleras para que se	compruebe la colision
04998   5CA8             ;----------------------------------------------------
04999   5CA8             
05000   5CA8             chkTocaMomia:
05001   5CA8 0E 00       		ld	c, 0		; Comienza por la primera momia
05002   5CAA             
05003   5CAA             chkNextMomia:
05004   5CAA 79          		ld	a, c
05005   5CAB CD DF 73    		call	getMomiaDat	; Obtiene puntero a los	datos de la momia
05006   5CAE 2A 62 E1    		ld	hl, (pMomiaProceso) ; Puntero a	los datos de la	momia en proceso
05007   5CB1 7E          		ld	a, (hl)
05008   5CB2 FE 04       		cp	4		; Esta andando,	saltando, cayendo o en unas escaleras?
05009   5CB4 38 04       		jr	c, chkTocaMomia2 ; Si
05010   5CB6             
05011   5CB6 FE 07       		cp	7		; Esta pensando?
05012   5CB8 20 27       		jr	nz, chkLastACTOR_ ; No,	pasa a la siguiete momia
05013   5CBA             
05014   5CBA             chkTocaMomia2:
05015   5CBA 3A 34 E1    		ld	a, (protaStatus) ; Status del prota
05016   5CBD 47          		ld	b, a
05017   5CBE FE 03       		cp	3		; Esta en unas escaleras?
05018   5CC0 28 05       		jr	z, chkTocaMomia3 ; si
05019   5CC2             
05020   5CC2 7E          		ld	a, (hl)		; Status de la momia
05021   5CC3 FE 03       		cp	3		; Esta la momia	en unas	escaleras?
05022   5CC5 20 04       		jr	nz, chkTocaMomia4 ; No
05023   5CC7             
05024   5CC7             chkTocaMomia3:
05025   5CC7 78          		ld	a, b
05026   5CC8 BE          		cp	(hl)		; Estan	ambos en unas escaleras?
05027   5CC9 20 16       		jr	nz, chkLastACTOR_ ; No,	entonces no se comprueba si se tocan
05028   5CCB             
05029   5CCB             chkTocaMomia4:
05030   5CCB 3A 3A E1    		ld	a, (ProtaRoom)	; Habitacion en	la que esta el prota
05031   5CCE DD BE 06    		cp	(ix+ACTOR_ROOM)	; Habitacion en	la que esta la momia
05032   5CD1 20 0E       		jr	nz, chkLastACTOR_ ; No estan en	la misma habitacion
05033   5CD3             
05034   5CD3 DD 56 03    		ld	d, (ix+ACTOR_Y)	; Y momia
05035   5CD6 DD 5E 05    		ld	e, (ix+ACTOR_X)	; X momia
05036   5CD9 21 F6 5C    		ld	hl, mummyHitArea
05037   5CDC CD FD 5C    		call	chkTocaProta	; Comprueba si el prota	toca a la momia
05038   5CDF 38 0B       		jr	c, momiaMataProta ; Si,	se tocan. El prota muere
05039   5CE1             
05040   5CE1             chkLastACTOR_:
05041   5CE1 0C          		inc	c		; Siguiente momia
05042   5CE2 21 64 E1    		ld	hl, numMomias	; Numero de momias de la piramide
05043   5CE5 79          		ld	a, c
05044   5CE6 BE          		cp	(hl)		; Ha comprobado	todas las momias?
05045   5CE7 C2 AA 5C    		jp	nz, chkNextMomia ; No
05046   5CEA             
05047   5CEA A7          		and	a
05048   5CEB C9          		ret
05049   5CEC             
05050   5CEC             momiaMataProta:
05051   5CEC 3E 1D       		ld	a, 1Dh		; Musica muere prota
05052   5CEE CD A9 7A    		call	setMusic
05053   5CF1 AF          		xor	a
05054   5CF2 32 53 E0    		ld	(flagVivo), a	; Mata al prota
05055   5CF5 C9          		ret
