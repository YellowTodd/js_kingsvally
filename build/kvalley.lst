05614   654A             
05615   654A             ;----------------------------------------------------
05616   654A             ; Borra	la gema	y los brillos tanto de la pantalla como	del mapa
05617   654A             ; Incrementa el	numero de gemas	cogidas
05618   654A             ; Indica a los cuchillos que tienen que	actualizar el fondo sobre el que estan
05619   654A             ;----------------------------------------------------
05620   654A             
05621   654A             gemaCogida:
05622   654A AF          		xor	a
05623   654B CD B5 65    		call	getGemaDat	; Obtiene puntero a los	datos de la gema en proceso
05624   654E 7E          		ld	a, (hl)
05625   654F E6 F0       		and	0F0h
05626   6551 77          		ld	(hl), a		; Desactiva gema del mapa
05627   6552             
05628   6552 23          		inc	hl
05629   6553 34          		inc	(hl)		; Pasa al siguiente estado
05630   6554             
05631   6554 23          		inc	hl
05632   6555 7E          		ld	a, (hl)		; Y
05633   6556 D6 08       		sub	8
05634   6558 57          		ld	d, a		; Coordenada Y del brillo de arriba de la gema
05635   6559 23          		inc	hl
05636   655A 23          		inc	hl
05637   655B 5E          		ld	e, (hl)		; X
05638   655C CD 28 5B    		call	coordVRAM_DE	; Obtiene direccion de la VRAM de esas coordenadas en la tabla de nombres
05639   655F AF          		xor	a		; Tile vacio
05640   6560 CD 4D 00    		call	WRTVRM		; Borra	el brillo superior
05641   6563             
05642   6563 01 1F 00    		ld	bc, 1Fh		; Distancia al brillo de la izquierda (tile de abajo a la izquierda)
05643   6566 09          		add	hl, bc
05644   6567 11 8A 65    		ld	de, eraseData	; Tiles	vacios
05645   656A 01 03 01    		ld	bc, 103h	; Ancho	de 3 tiles
05646   656D CD C8 65    		call	DEtoVRAM_NXNY	; Borra	de la pantalla el brillo de la izquierda, la gema y el brillo de la derecha
05647   6570             
05648   6570 3E 02       		ld	a, 2		; Offset variable Y
05649   6572 CD B5 65    		call	getGemaDat
05650   6575 CD D6 50    		call	getMapOffset00	; Obtiene en HL	el puntero al mapa de las coodenadas apuntada por HL
05651   6578 11 8A 65    		ld	de, eraseData
05652   657B CD D7 65    		call	putBrillosMap	; Borra	los brillos del	mapa
05653   657E             
05654   657E 21 F2 E1    		ld	hl, gemasCogidas
05655   6581 34          		inc	(hl)		; Incrementa el	numero de gemas	cogidas
05656   6582             
05657   6582 CD 53 66    		call	knifeUpdateBack	; Fuerza a los cuchillos a actualizar el tile de fondo sobre el	que estan
05658   6585             					; Podia	estar sobre el brillo de la gema y ahiora que se ha quitado hay	que actualizarlo
05659   6585 C3 A6 65    		jp	chkLastGema
