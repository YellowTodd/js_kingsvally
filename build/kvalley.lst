05790   65EA             ;----------------------------------------------------------------
05791   65EA             ;
05792   65EA             ; Logica de las	puertas	de entrada y salida de la piramide
05793   65EA             ;
05794   65EA             ; La puerta por	la que se entra	en la piramide tiene status 1 (#10)
05795   65EA             ; Las puertas por las que se sale tienen status	0 si no	se ha pasado previamente la piramide
05796   65EA             ; Si ya	se habian cogido las gemas, las	puertas	tienen status 8	(#80)
05797   65EA             ; Comprueba si se han cogido todas las gemas
05798   65EA             ; Anima	las puertas al entrar y	salir de la piramide
05799   65EA             ; Comprueba si se toca la palanca que abre la salida al	terminar una fase
05800   65EA             ; Si la	piramide ya se ha visitado, no oculta la salida
05801   65EA             ;
05802   65EA             ;----------------------------------------------------------------
05803   65EA             
05804   65EA             AI_Salidas:
05805   65EA AF          		xor	a
05806   65EB 32 F4 E1    		ld	(ElemEnProceso), a ; Usado para	saber la gema o	puerta que se esta procesando
05807   65EE 32 C2 E1    		ld	(puertaCerrada), a ; Vale 1 al cerrarse	la salida
05808   65F1             
05809   65F1             chkNextExit:
05810   65F1 21 67 67    		ld	hl, chkLastExit	; Comprueba si ya ha comprobado	las cuatro salidas
05811   65F4 E5          		push	hl		; Mete esta funcion en la pila para que	se ejecute al salir
05812   65F5             
05813   65F5 AF          		xor	a
05814   65F6 CD 5B 67    		call	getExitDat	; Obtiene un puntero a la salida que se	esta procesando
05815   65F9 3C          		inc	a		; Es #ff su estatus?
05816   65FA C8          		ret	z		; No existe esa	salida
05817   65FB             
05818   65FB 23          		inc	hl
05819   65FC 23          		inc	hl
05820   65FD 23          		inc	hl
05821   65FE 23          		inc	hl
05822   65FF 7E          		ld	a, (hl)		; Status de la puerta
05823   6600 1F          		rra
05824   6601 1F          		rra
05825   6602 1F          		rra
05826   6603 1F          		rra
05827   6604 E6 0F       		and	0Fh		; El nibble alto indica	el status. El bajo se usa como contador	de animacion o substatus
05828   6606 CD 4B 40    		call	jumpIndex
05829   6609             
05830   6609             
05831   6609 1B 66       		dw chkAllGemas		; 0 = Comprueba	si se han cogido todas las gemas
05832   660B 37 66       		dw paintEntrada		; 1 = Dibuja la	puerta de entrada a la piramide
05833   660D 6A 66       		dw chkOpenExit		; 2 = Comprueba	si toca	la palanca que abre la puerta
05834   660F 94 66       		dw openCloseExit	; 3 = Abriendo salida
05835   6611 E0 66       		dw chkSalePiram		; 4 = Puerta abierta. Espera a que salga de la piramide
05836   6613 94 66       		dw openCloseExit	; 5 = Cerrando salida
05837   6615 36 66       		dw doNothing3		; 6 = No hace nada. Mantiene la	puerta esperando a la cortinilla
05838   6617 45 67       		dw finAnimEntrar	; 7 = Quita o deja la puerta dependiendo de si ya ha estado en la piramide
05839   6619 42 66       		dw paintCerrada		; 8 = La puerta	permanece visible y cerrada
05840   661B             
05841   661B             ;----------------------------------------------------------------
05842   661B             ;
05843   661B             ; Comprueba si se han cogido todas las gemas de	la fase
05844   661B             ;
05845   661B             ; Esta comprobacion la hace cada puerta	existente (normalmente la de entrada y	la de salida)
05846   661B             ; Con lo que ambas puertas pasan a estado 1 al pasarse la fase.
05847   661B             ;
05848   661B             ; Cuando se cogen todas:
05849   661B             ; - se marca la	fase como terminada
05850   661B             ; - suena la musica de "stage clear"
05851   661B             ; - quita las puertas giratorias
05852   661B             ; - pasa la puerta al status 1 (#10)
05853   661B             ;----------------------------------------------------------------
05854   661B             
05855   661B             chkAllGemas:
05856   661B 21 F2 E1    		ld	hl, gemasCogidas ; Comprueba si	ha cogido todas	la gemas
05857   661E 7E          		ld	a, (hl)		; Gemas	recogidas
05858   661F 23          		inc	hl
05859   6620 BE          		cp	(hl)		; Numero de gemas que hay en esta piramide
05860   6621 C0          		ret	nz		; No las ha cogido todas
05861   6622             
05862   6622 3E 01       		ld	a, 1
05863   6624 32 33 E1    		ld	(flagStageClear), a
05864   6627             
05865   6627 3E 94       		ld	a, 94h
05866   6629 CD A9 7A    		call	setMusic	; Musica de "stage clear"
05867   662C             
05868   662C CD 31 6A    		call	quitaGiratorias	; Quita	las puerta giratorias
05869   662F 3E 04       		ld	a, 4		; Offset al byte de status de la puerta
05870   6631 CD 5B 67    		call	getExitDat	; Obtiene un puntero a la salida que se	esta procesando
05871   6634 36 10       		ld	(hl), 10h	; Status = #10
05872   6636             
05873   6636             doNothing3:
05874   6636 C9          		ret
05875   6637             
05876   6637             
05877   6637             ;----------------------------------------------------------------
05878   6637             ;
05879   6637             ; Dibuja la puerta abierta si se esta entrando en la piramide
05880   6637             ; o cerrada si acaba de	aparecer tras coger las	gemas
05881   6637             ; Pasa la puerta al status 2 (#20) que comprueba si el prota toca la palanca que abre la puerta
05882   6637             ;----------------------------------------------------------------
05883   6637             
