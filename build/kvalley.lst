05688   65A6             ;----------------------------------------------------
05689   65A6             ; Comprueba si ha procesado todas las gemas
05690   65A6             ;----------------------------------------------------
05691   65A6             	IF	(VERSION2)
05692   65A6             	
05693   65A6             chkLastGema:
05694   65A6 CD AD 65    		call	chkLastGema2	; Se han procesado todas las gemas?
05695   65A9 C8          		ret	z		; Si
05696   65AA C3 36 65    		jp	nextGema	; No, sigue con otra
05697   65AD             chkLastGema2:		
05698   65AD 21 F4 E1    		ld	hl, ElemEnProceso ; Usado para saber la	gema o puerta que se esta procesando
05699   65B0 34          		inc	(hl)		; Siguiente gema
05700   65B1 7E          		ld	a, (hl)
05701   65B2 2B          		dec	hl
05702   65B3 BE          		cp	(hl)		; Ha procesado todas?
05703   65B4 C9          		ret
05704   65B5             	ELSE
05705   65B5~            	
05706   65B5~            chkLastGema:
05707   65B5~            		ld	hl, ElemEnProceso ; Usado para saber la	gema o puerta que se esta procesando
05708   65B5~            		inc	(hl)		; Siguiente gema
05709   65B5~            		ld	a, (hl)
05710   65B5~            		dec	hl
05711   65B5~            		cp	(hl)		; Ha procesado todas?
05712   65B5~            		ret	z		; Si, termina
05713   65B5~            		jp	nextGema	; No, procesa la siguiente
05714   65B5             	ENDIF
